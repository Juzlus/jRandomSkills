<Project Sdk="Microsoft.NET.Sdk">
    <!-- Shared API from https://github.com/b3none/cs2-retakes (GPLv3). Ship the built DLL to
         addons/counterstrikesharp/shared/RetakesPluginShared/ so allocator plugins can talk to retakes. -->
    <PropertyGroup>
        <PackageId>RetakesPluginShared</PackageId>
        <Authors>B3none</Authors>
        <Version>2.0.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>RetakesPluginShared</RootNamespace>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <DebugType>portable</DebugType>
    </PropertyGroup>
</Project>
